---
// src/pages/about.astro - who the SC Speakers Bureau is, and what this site does.
//
// ORDER IS THE POINT. The Bureau comes first and in full, because that is the
// organisation the reader came for. Everything about the reading room comes
// after, under its own heading, and is short: it is mechanism, not identity.
//
// The two sections are kept visibly separate because they answer different
// questions and have different authority. "Who are you" is answered by the
// Bureau's own words. "What is this page and why does it only hold recent
// posts" is answered from the dataset, so its numbers are computed rather than
// typed and cannot drift away from the articles actually on the site.
//
// Nothing on this page is a stand-in for copy that has not arrived. If a fact is
// not in data/events.schema.md, data/articles.json or a constant in src/lib/site.ts,
// it is not stated here.

import PageShell from '../components/PageShell.astro'
import { articles, formatUtcDate, publicationNames, summarise, topics } from '../lib/articles'
import { SITE_NAME, SITE_WINDOW_NOTE } from '../lib/site'

const feed = articles
const stats = summarise(feed)
const publications = publicationNames(feed)
const topicList = topics(feed)

const description =
  `The SC Speakers Bureau is a 501(c)(3) nonprofit that brings speakers on tour to ` +
  `inform and educate local citizens. Its reading room collects and links the most ` +
  `recent writing from independent publications.`
---

<PageShell title="About" description={description}>
  <div class="page-head">
    <p class="label page-head__label">About</p>
    <h1 class="page-head__title">The SC Speakers Bureau</h1>
  </div>

  <div class="prose">
    <section aria-labelledby="about-bureau">
      <h2 id="about-bureau">About the Bureau</h2>
      <p>
        The SC Speakers Bureau is a 501(c)(3) nonprofit founded in South Carolina.
      </p>
      <p>
        It began with a few Carolinians who saw a need: to bring speakers on tours,
        so that people could be given the education those events make possible.
        After the first speaking tour it became clear that the events really did
        influence the people who attended them, and the founders of the Bureau
        carried on with the work of making sure there would be future tours.
      </p>
      <p>
        The Bureau now brings speakers to South Carolina, Georgia and North
        Carolina, to inform and educate local citizens on topics important to
        maintaining a constitutional republic in South Carolina and the United
        States.
      </p>
    </section>

    <hr />

    <section aria-labelledby="about-site">
      <h2 id="about-site">About {SITE_NAME}</h2>
      <p>
        This is the Bureau's reading room. A scheduled job reads the RSS feed of
        each publication listed in the site's own configuration, checks that each
        response really is a feed, normalises the posts into one dataset, and
        rebuilds the site. If a feed fails to validate, the job fails loudly and
        the site is not rebuilt on stale data.
      </p>
      <p>
        Articles are not copied here. Each one links out to the publication that
        wrote it, and it opens on that publication's own site in a new tab.
      </p>
    </section>

    <hr />

    <section aria-labelledby="about-window">
      <h2 id="about-window">What is in the window, and what is not</h2>
      <p>{SITE_WINDOW_NOTE}</p>
      <p>
        At the moment that window holds <strong>{stats.total}</strong> article
        {stats.total === 1 ? '' : 's'}
        {
          stats.oldest && stats.newest && (
            <>
              , published between <strong>{formatUtcDate(stats.oldest)}</strong> and{' '}
              <strong>{formatUtcDate(stats.newest)}</strong>
            </>
          )
        }
        .
      </p>
      <p>
        Of those, <strong>{stats.withByline}</strong> carry an individual author's
        name and <strong>{stats.suppressedByline}</strong> report the publication
        itself as the author, which is not printed as though it were a person.
      </p>
      <p>
        A publication that stops publishing will quietly age out of this window,
        and so will an article that ages out of its feed. If a source here has
        been silent for a long time, that is a fact about the source, not a gap
        in the collection.
      </p>
    </section>

    <hr />

    <section aria-labelledby="about-sources">
      <h2 id="about-sources">Where the writing comes from</h2>
      <p>
        These publications are independent and are not affiliated with the SC
        Speakers Bureau or with this site. They are linked to, not reproduced.
      </p>
      <ul>
        {publications.map((name) => <li>{name}</li>)}
      </ul>
      {
        topicList.length > 0 && (
          <p>
            {topicList.length === 1 ? 'One topic tag is' : `${topicList.length} topic tags are`} in
            use: {topicList.map((topic) => topic.label.toLowerCase()).join(', ')}.
          </p>
        )
      }
    </section>
  </div>
</PageShell>

<style>
  .page-head {
    padding-block-end: var(--space-5);
    margin-block-end: var(--space-5);
    border-block-end: var(--rule-width) solid var(--rule);
  }

  .page-head__label {
    margin-block-end: var(--space-2);
  }

  .page-head__title {
    font-size: var(--size-3xl);
  }

  /* Prose gets the reading measure; everything else on the site is a feed and
     runs wide. */
  .prose {
    max-width: var(--measure);
  }

  .prose h2 {
    margin-block-end: var(--space-3);
    font-size: var(--size-xl);
  }
</style>
