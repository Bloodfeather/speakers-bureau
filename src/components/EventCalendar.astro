---
// src/components/EventCalendar.astro - the month grids.
//
// ---------------------------------------------------------------------------
// WHAT "INTERACTIVE" MEANS HERE, PRECISELY
// ---------------------------------------------------------------------------
//
// Clicking a date selects that DAY, and the info panel beside it updates. That is
// the whole interaction, and it is implemented with a hidden radio input per day
// plus `<label for>` - the same mechanism the theme switcher already uses in this
// project, for the same reason: it works with scripting off, cannot flash, and
// gets keyboard support from the platform.
//
// The selection unit is a DAY rather than an event because two events can share a
// date, and a calendar cell is a date. Selecting a date therefore selects
// everything on it, and the panel stacks them.
//
// ---------------------------------------------------------------------------
// A DAY INSIDE A MULTI-DAY EVENT IS NOT A DAY YOU CAN SELECT
// ---------------------------------------------------------------------------
//
// Early voting runs 19 to 31 October 2026. The panel and the list both print that
// range. Marking only the 19th and rendering the following twelve dates as
// ordinary empty squares would say, in the DEFAULT view of the page, that voter
// access existed on one day of thirteen - while the page's own prose, two hundred
// pixels away, said otherwise. `eventDays` consults `endsAt` on the grid path.
//
// Three states render here, and which one it is decides everything else:
//
//   event day    <label for="day-...">      ring marker, event name, selectable
//   covered day  <span>                     rule marker, hidden explanation, inert
//   empty day    <span class="--bare">      no marker, nothing to select
//
// A COVERED DAY GETS NO RADIO, NO PANEL AND NO GENERATED SELECTOR. That is a
// decision, not an omission: the event is listed once, on the day it starts, with
// its range. A radio per covered day would be a control that can be focused,
// checked, and announced as a selectable date, opening a panel with nothing in it -
// which is worse than the original defect, because it looks like working selection
// machinery. So `data-day` is on the clickable cell only, and the page's generated
// `html:has(#day-<key>:checked) [data-day='<key>']` rules cannot reach a covered
// day at all.
//
// IT IS STILL TOLD TO THE READER, TWICE, in two channels that survive the failure
// modes colour does not. A SHAPE beside the numeral (`.cal__mark--span`, a rule
// drawn with a border, so it is not erased by forced-colours mode) for a sighted
// reader, and real TEXT for a screen reader - naming the event, the range it runs
// and the date it is listed on. The text is inside the cell rather than in a
// `title` attribute because a tooltip is unreachable by keyboard and unannounced.
//
// ---------------------------------------------------------------------------
// WHY ONLY MONTHS THAT HAVE EVENTS
// ---------------------------------------------------------------------------
//
// Rendering every month would require either a second selection group or URL state
// to remember which month the reader was on, and it would buy browsing months that
// contain nothing. A speakers bureau has no events in an empty month, so an empty
// grid is not information. Decided with the client.
//
// ONE QUALIFICATION. "A month that has nothing in
// it" now has to mean "a month in which no event runs and no event runs THROUGH",
// not "a month with no event START date in it". A span crossing a month boundary
// puts covered days in the second month, and those dates have to be visible
// somewhere or the reader is back to being told the event is not on them. So the
// month list is derived from every day `eventDays` produced, covered ones included,
// and a month that holds only covered days still renders.
//
// ---------------------------------------------------------------------------
// A REAL <table>, AND WHY
// ---------------------------------------------------------------------------
//
// A month grid is tabular data - a caption, column headers, and cells in rows -
// so it is marked up as a table and gets row/column semantics from the platform
// rather than from ARIA applied afterwards. The caption is the month name, which
// means a screen reader announces "November 2026" on entering the grid instead of
// leaving the reader to infer it from seven day numbers.
//
// SUNDAY FIRST. That is the convention for a US civic audience; the week-start is
// one line to change for a locale that begins on Monday.
//
// The day cells are padding-free where it matters: leading and trailing cells
// belong to the adjacent months and carry no day number, so a reader scanning the
// grid is never shown a date that is not in this month.
// ---------------------------------------------------------------------------

import type { MonthGrid } from '../lib/calendar'
import { continuationLabel, WEEKDAY_FULL, WEEKDAY_LABELS } from '../lib/calendar'

interface Props {
  months: MonthGrid[]
  /** `YYYY-MM-DD` keys for dates that have already passed. */
  pastKeys?: readonly string[]
}

// NO `selectedKey` PROP. See the note on aria-current below:
// the only thing it would feed is an attribute whose value is fixed at build time,
// so passing it in would be passing a constant to a component that has no way to
// keep it true. The selected cell is marked by the page's generated per-day selectors,
// which move with the radio's real `:checked` state.

const { months, pastKeys = [] } = Astro.props

/** A Set, because this is looked up once per cell and an array scan is O(n^2). */
const past = new Set(pastKeys)

/** Chunk a month's flat cells into rows of seven. */
function toWeeks(cells: MonthGrid['cells']): MonthGrid['cells'][] {
  const weeks = []
  for (let i = 0; i < cells.length; i += 7) weeks.push(cells.slice(i, i + 7))
  return weeks
}
---

<div class="cal">
  {
    months.map((month) => (
      <section class="cal__month">
        <table class="cal__table">
          <caption class="cal__caption">{month.label}</caption>
          <thead>
            <tr>
              {WEEKDAY_LABELS.map((label, index) => (
                <th class="cal__weekday" scope="col">
                  <abbr title={WEEKDAY_FULL[index]}>{label}</abbr>
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {toWeeks(month.cells).map((week) => (
              <tr>
                {week.map((cell) => (
                  <td class="cal__cell">
                    {cell.day && cell.day.events.length > 0 ? (
                      <label
                        class="cal__day"
                        for={`day-${cell.day.key}`}
                        data-day={cell.day.key}
                        data-past={past.has(cell.day.key) ? 'true' : undefined}
                      >
                        <span class="cal__daynum">
                          {cell.dayNumber}
                          {/* A SHAPE, not a tint. See the note on .cal__mark below. */}
                          <span class="cal__mark" aria-hidden="true" />
                          {cell.day.continues && (
                            <span class="cal__mark cal__mark--span" aria-hidden="true" />
                          )}
                        </span>
                        <span class="cal__dayname">{cell.day.events[0].name}</span>
                        {cell.day.multiple && (
                          <span class="cal__count">
                            +{cell.day.count - 1} more
                          </span>
                        )}
                        {past.has(cell.day.key) && (
                          <span class="visually-hidden">(already held)</span>
                        )}
                        {cell.day.continues && (
                          <span class="visually-hidden">({continuationLabel(cell.day)})</span>
                        )}
                      </label>
                    ) : cell.day ? (
                      /*
                        A DAY A MULTI-DAY EVENT RUNS THROUGH, and nothing more.
                        THIS IS AN INERT SPAN, NOT A LABEL, and it is the single most
                        load-bearing decision in this component.

                        A `<label>` here would point at a `#day-<key>` radio that does
                        not exist. The alternative - giving every covered day its
                        own radio, its own panel and its own generated
                        `html:has(#day-...)` rule - was rejected on purpose: the
                        event is listed ONCE, on the day it starts, with its full
                        range. A radio per covered day would mean a date that can be
                        selected, passes keyboard focus, and opens an empty panel.

                        So: no `for`, no `data-day` (which is what the page's generated
                        selectors target), no radio, no panel. The reader is told the
                        day is covered by a MARKER and by TEXT, and cannot select it,
                        which is the truth.
                      */
                      <span
                        class="cal__day cal__day--continues"
                        data-continues="true"
                        data-past={past.has(cell.day.key) ? 'true' : undefined}
                      >
                        <span class="cal__daynum">
                          {cell.dayNumber}
                          <span class="cal__mark cal__mark--span" aria-hidden="true" />
                        </span>
                        <span class="visually-hidden">
                          ({continuationLabel(cell.day)})
                        </span>
                        {past.has(cell.day.key) && (
                          <span class="visually-hidden">(already held)</span>
                        )}
                      </span>
                    ) : cell.dayNumber !== null ? (
                      <span class="cal__day cal__day--bare">
                        <span class="cal__daynum">{cell.dayNumber}</span>
                      </span>
                    ) : (
                      <span class="cal__pad" />
                    )}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </section>
    ))
  }

  {/*
    WHY THERE IS NO aria-current ON THESE CELLS, AND WHY IT MUST NOT COME BACK.

    It was here, rendered from a `selectedKey` prop, and it was WRONG rather than
    merely redundant. The prop is a BUILD-TIME constant: events.astro picks the
    first upcoming day once, while rendering, and hands the same string to every
    cell. The attribute is therefore baked into the HTML and can never change. A
    reader who then selects a different date gets the CSS `:checked` styling moved
    by the page's generated per-day selectors, while the accessibility tree goes on
    reporting the OLD cell as current - a cell that is not current, marked as
    current, in the document a screen reader is reading. That is worse than no
    signal at all, and it is invisible in review because the markup is correct as
    written and only becomes false after the reader acts.

    There is no CSS or HTML mechanism that could maintain it. CSS cannot write an
    ARIA attribute, and an attribute's value cannot be expressed as a selector. In
    a design with no JavaScript, an attribute that describes the current state can
    only be maintained by JavaScript, so on this page it cannot be.

    THE STATE IS ALREADY CARRIED, twice over, and both are verified in the built
    markup rather than assumed:

      1. The day RADIO. Each date is a real `input type="radio"` with an
         `aria-label` naming the date and its event count, and the selected one
         carries `checked`. That is platform state: it moves with the selection and
         it is what a screen reader announces when the reader arrows between dates.
         This is the same mechanism the theme switcher in this project uses.
      2. The PANEL, in events.astro, which is `aria-live="polite"` and renders a
         block per date with the date as its label. Changing the selection changes
         what is visible inside that region, which is what makes the region announce
         the new date.

    So removing the attribute loses no announcement. What it removes is a false
    one.
  */}
  {
    months.length === 0 && (
      <p class="cal__empty">No months with events are listed at the moment.</p>
    )
  }
</div>

<style>
  /* Every class in this file is rendered by this file, so one Astro scope id
     covers all of them. That is the whole reason these rules are not in
     events.astro: a rule in a page's scoped block cannot match an element another
     component renders, and it fails SILENTLY. See "THE PER-DAY SELECTORS" in
     events.astro. */
  .cal {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .cal__table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
  }

  .cal__caption {
    padding-block-end: var(--space-2);
    font-family: var(--font-display);
    font-size: var(--size-md);
    font-weight: var(--weight-bold);
    text-align: start;
    color: var(--text);
  }

  .cal__weekday {
    padding-block-end: var(--space-2);
    font-size: var(--size-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    text-align: start;
    color: var(--text-muted);
    border-block-end: var(--rule-width) solid var(--rule);
  }

  /* The browser's dotted underline on <abbr> is noise on a grid header where the
     full name is decoration rather than a definition. */
  .cal__weekday abbr {
    text-decoration: none;
  }

  .cal__cell {
    padding: 0;
    vertical-align: top;
    border: var(--rule-width) solid var(--rule);
  }

  .cal__day {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    /* A minimum HEIGHT rather than an aspect-ratio square, so a wide phone does
       not get five enormous rows and a narrow desktop does not get tiny ones. */
    min-height: 3.75rem;
    padding: var(--space-2);
    cursor: pointer;
  }

  .cal__day:hover .cal__dayname {
    color: var(--link-hover);
  }

  /* inline-flex rather than a bare span, so the marker sits beside the numeral on
     one baseline row instead of drifting onto its own line. */
  .cal__daynum {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--size-sm);
    font-weight: var(--weight-bold);
    font-variant-numeric: tabular-nums;
    color: var(--text-muted);
  }

  /* ------------------------------------------------------------------------
   * WHY A MARKER, AND WHY IT IS DRAWN WITH A BORDER
   * --------------------------------------------------------------------- *
   *
   * The cell carries a SHAPE as well as the numeral's text colour, muted to full
   * contrast, because colour alone is a hue difference, and a hue is exactly what
   * disappears in forced-colours mode, in greyscale print, and for any reader with
   * a colour vision deficiency. The event NAME in the cell is text and therefore
   * survives, but it is clamped to two lines, so on a long name a reader scanning
   * for "which dates are worth selecting" can be left with a clipped fragment and
   * no marker at all.
   *
   * The shape is what the selection state is not: it cannot be turned off by a
   * palette.
   *
   * DRAWN WITH A BORDER RATHER THAN A BACKGROUND, and that is the part that
   * matters. In forced-colours mode the user agent overrides background-color to
   * the canvas colour, so a dot painted with `background: currentColor` becomes
   * invisible - a cue that exists in the stylesheet and is absent exactly where it
   * is needed most. Border-width and border-style are NOT overridden, so a
   * ring drawn with a border keeps its shape and its size.
   *
   * Subtle on purpose: 5px, no fill, hairline-adjacent weight. It has to read as
   * a mark on a printed programme, not as a notification badge.
   */
  .cal__mark {
    display: inline-block;
    flex: none;
    width: 5px;
    height: 5px;
    border: var(--rule-width-strong) solid currentColor;
    border-radius: var(--radius-pill);
  }

  /* The empty-day cell renders no .cal__mark at all, which is the whole mechanism:
     presence of the element is the signal, so it cannot be lost to a theme. */

  /* ------------------------------------------------------------------------
   * .cal__mark--span - THE COVERED-DAY MARKER
   * --------------------------------------------------------------------- *
   *
   * A DAY INSIDE A MULTI-DAY EVENT, as opposed to the day the event starts.
   * Early voting runs 19 to 31 October 2026; before this marker existed the grid
   * marked the 19th and rendered 20 through 31 as ordinary empty squares, while
   * the panel and the list both said "19 - 31 October 2026". The default view of
   * the page therefore understated voter access on twelve of the thirteen days
   * it runs - confidently, and in the pessimistic direction.
   *
   * It is a DIFFERENT SHAPE from `.cal__mark`, and it has to be, for two reasons:
   *
   *   1. It must differ from a genuinely empty day, which carries no marker at
   *      all. That is already a difference, but a reader who has learned "a dot
   *      means something starts here" would learn nothing new.
   *   2. It must differ from the FIRST DAY of the span, which carries the ring and
   *      is selectable, while this is not. A covered day that looked identical to
   *      an event day would be a cell that looks clickable and is not.
   *
   * SO IT IS A RULE BESIDE THE NUMERAL, not a second ring. A short horizontal bar
   * reads as "this continues", where a second dot would read as "and another event
   * starts here" - which is false, and would put the count on the page out by one
   * on every covered date.
   *
   * DRAWN WITH A BORDER, for the same reason as `.cal__mark` and stated there:
   * forced-colours mode overrides `background-color` to the canvas colour, so a
   * bar painted that way vanishes in exactly the mode it exists for.
   * `border-block-end` is not overridden, so the bar keeps its weight and length.
   *
   * `height: 0` with a border is not a mistake and not a hack: an element with no
   * content box and one bottom border IS a rule, and it is the same shape a
   * `border-block-start` under a heading draws. The `width` is what makes it a
   * mark rather than a hairline.
   *
   * DELIBERATELY NOT THE SAME SIZE OR WEIGHT AS THE SELECTION BAR. Selection is a
   * `--rule-width-strong` bar down the inline-start edge of the cell, drawn by the
   * page's generated selectors. Two full-height bars in one cell would compete.
   */
  /* `.cal__mark.cal__mark--span`, NOT `.cal__mark--span`. The element carries BOTH
     classes, and the base `.cal__mark` rule would otherwise also apply to it -
     giving it the ring's width, height, border and radius. With equal specificity
     the later rule wins, so the override would work, but it would work only because
     of SOURCE ORDER, which is exactly the kind of correctness-by-accident this file
     has been bitten by. Naming both classes raises specificity above the base rule
     and makes the override hold wherever the stylesheet is assembled.
     `.cal__mark`'s `display: inline-block` and `flex: none` are still inherited,
     which is wanted - the bar needs to sit on the numeral's baseline row. */
  .cal__mark.cal__mark--span {
    width: 12px;
    height: 0;
    border: 0;
    border-block-end: var(--rule-width-strong) solid currentColor;
    border-radius: 0;
  }

  /* The covered-day CELL. Inert: not a label, no pointer, no hover state. The
     `.cal__day` class is shared with the clickable cell so the padding and the
     minimum height are identical - a grid whose covered days were a different
     height from its empty days would look like a rendering fault. */
  .cal__day--continues {
    cursor: default;
  }

  /* The covered day is muted, because it is context rather than an entry point -
     but ONLY the numeral, and never as the sole signal. The marker above is the
     signal; this is decoration that happens to make the grid easier to read. */
  .cal__day--continues .cal__daynum {
    color: var(--text-muted);
  }

  /* The legend that explains the marker is rendered by events.astro, in the PAGE's
     scoped style block, and deliberately not here. Two facts make that correct:
   *
   *   - This component renders no prose. Every other string in this file is a day
   *     number or an event name that came from the data.
   *   - A rule in a page's scoped block CANNOT match an element another component
   *     renders. It fails SILENTLY, which is how a page ships with no focus ring and
   *     nothing in the suite goes red. See the note on the per-day selectors in events.astro.
   *
   * What must live HERE is the marker itself, because these cells are rendered
   * here and nowhere else. That split is the whole lesson of the two files. */

  /*
    THE EVENT NAME IN THE CELL, CLAMPED TO TWO LINES.

    This is the one place in the project that truncates text, and it is different
    from ArticleCard's rule on purpose. A card is the only place its excerpt
    appears, so clamping there hides content. A calendar cell is a navigation
    target: the full name is one selection away in the panel, and the cell's job
    is to let a reader see at a glance WHICH dates are worth selecting. Clamping
    to two lines keeps the grid's rows even, which is what makes it scannable.
  */
  .cal__dayname {
    font-size: var(--size-xs);
    line-height: var(--leading-snug);
    color: var(--text);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .cal__count {
    font-size: var(--size-xs);
    color: var(--text-muted);
  }

  /* A date with no events: the number is shown, so the grid still reads as a
     calendar, but there is nothing to select and no label to click. */
  .cal__day--bare {
    cursor: default;
  }

  .cal__pad {
    display: block;
    min-height: 3.75rem;
  }

  /* SELECTION IS NOT A TINT.

     The selected cell is filled AND ruled by the page's generated per-day
     selectors (`html:has(#day-<key>:checked) [data-day='<key>']`), and the
     background is `var(--chip-bg)`. So the shape of the selection - a ruled bar
     down the inline-start edge - survives forced colours, where the fill does not.
     The contrast change on the day number below is a second, weaker cue and is
     deliberately NOT relied on: calling it one of "the two non-colour signals"
     would be wrong, because a change in text colour is a colour signal.

     `data-day` is on the event-day label only, so `:has()` here is a second route
     to the same cells the marker reaches. */
  .cal__day:has(.cal__dayname) .cal__daynum {
    color: var(--text);
  }

  /*
    A DATE ALREADY HELD. Marked with a DOTTED RULE under the day number as well as
    with muted text, because the muted text alone is a colour-only signal. Nothing
    is hidden: a bureau's past engagements are part of the record, and the list view
    shows them under "Already held" rather than dropping them.
  */
  .cal__day[data-past='true'] .cal__daynum {
    color: var(--text-muted);
    text-decoration: underline dotted;
    text-underline-offset: 0.2em;
  }

  .cal__day[data-past='true'] .cal__dayname {
    color: var(--text-muted);
  }

  .cal__empty {
    font-size: var(--size-sm);
    color: var(--text-muted);
  }
</style>
