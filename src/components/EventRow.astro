---
// src/components/EventRow.astro - one event in the LIST view.
//
// ---------------------------------------------------------------------------
// WHAT CHANGED, AND WHY IT IS BETTER
// ---------------------------------------------------------------------------
//
// Previously this component owned a radio input and its accessible name was the
// event's. It no longer does. The selection unit is now a DAY, and the day radios
// live in ONE hidden group in the page - so the same date can be selected from
// either the calendar or the list, and both stay in sync with no JavaScript.
//
// The consequence worth stating: this row is now a `<label for>` pointing at a
// shared radio, so its accessible name comes from the DAY's radio, not from the
// event's own text. `dayRadioLabel()` in src/lib/calendar.ts names each radio
// "14 November 2026, 1 event", which is correct in both views because both views
// select days. The event name is right there in the row, visually, and the panel
// gives the full detail.
//
// If two events share a date, both of their rows target the SAME radio, and both
// therefore show as selected together. That is honest: the panel is showing that
// day, and both events are on it.
//
// WHY THE SELECTED AND FOCUSED RULES ARE NOT HERE: the day radio this label names
// lives in events.astro, and CSS cannot relate a label to a control it merely
// names. Those rules are generated per date there - see "THE PER-DAY SELECTORS",
// including why they must stay UNSCOPED, and the test that fails if a class owned
// by this component appears in that page's scoped <style>.

import type { EventRecord } from '../lib/events'
import { formatEventDateSpan, formatEventTime, machineDateTime } from '../lib/events'
import { withBase } from '../lib/site'

interface Props {
  event: EventRecord
  /** The `YYYY-MM-DD` this row selects. */
  dayKey: string
  /** Rendered on rows for days that are already past. */
  past?: boolean
  /** True for the second and later rows sharing one date. */
  sharesDay?: boolean
}

const { event, dayKey, past = false, sharesDay = false } = Astro.props

// The span, for the same reason as in EventDetail.astro: a seventeen-day early
// voting window must not be labelled with its first day.
const dateLabel = formatEventDateSpan(event.startsAt, event.endsAt)
const timeLabel = formatEventTime(event.startsAt, event.endsAt)
const machine = machineDateTime(event.startsAt)
---

<li class="row-item">
  <label class="row" for={`day-${dayKey}`} data-day={dayKey}>
    {
      event.thumbnail && (
        <span class="row__thumb">
          <img
            class="row__image"
            src={withBase(event.thumbnail)}
            alt=""
            loading="lazy"
            decoding="async"
            width="480"
            height="320"
          />
        </span>
      )
    }

    <span class="row__body">
      <span class="row__top">
        <span class="chip row__type">{event.type}</span>
        {past && <span class="row__flag">already held</span>}
        {sharesDay && <span class="row__flag">also on this date</span>}
      </span>

      <span class="row__name">{event.name}</span>

      <span class="row__meta">
        <!--
          ONE LINE, ON PURPOSE, and the comma lives here rather than in a
          `::before`. Both approaches were tried against the same defect: JSX
          collapses the line break between two expressions into a space, so a
          separate span produced "6 October 2026 , 7:00 pm" - a space before the
          comma, measured in the browser rather than assumed. Emitting the comma in
          the markup with no whitespace around it is the only version that cannot
          drift. See the same comment in EventDetail.astro.
        -->
        <time class="row__when" datetime={machine}>{dateLabel}{timeLabel && <span class="row__time">{`, ${timeLabel}`}</span>}</time>
        <span class="row__location">{event.location}</span>
      </span>
    </span>
  </label>
</li>

<style>
  .row-item {
    border-block-start: var(--rule-width) solid var(--rule);
  }

  .row {
    display: flex;
    gap: var(--space-4);
    padding-block: var(--space-4);
    cursor: pointer;
  }

  .row:hover .row__name {
    color: var(--link-hover);
  }

  .row__thumb {
    flex: 0 0 4.5rem;
    align-self: flex-start;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--chip-bg);
    border: var(--rule-width) solid var(--rule);
    border-radius: var(--radius-sm);
  }

  .row__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .row__body {
    display: flex;
    flex: 1 1 auto;
    min-width: 0;
    flex-direction: column;
    gap: var(--space-2);
  }

  .row__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
  }

  .row__flag {
    font-size: var(--size-xs);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .row__name {
    font-family: var(--font-display);
    font-size: var(--size-md);
    font-weight: var(--weight-bold);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-tight);
    color: var(--text);
  }

  .row__meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    font-size: var(--size-sm);
    color: var(--text-muted);
  }

  /* The clock time is set apart from the date so a reader scanning for "is that
     an evening event" can find it without reading the month. The comma before it
     is in the markup, not here: a `::before` cannot remove the whitespace JSX
     already emitted between the two spans. */
</style>
