---
// src/components/SiteHeader.astro - the masthead: organisation name, one line of
// positioning, and the primary navigation.
//
// ---------------------------------------------------------------------------
// NOTE ON THE TWO NAMES, AND ON WHAT IS NOT IN HERE
// ---------------------------------------------------------------------------
//
// "The Citizen's Reading Room" is the publication. "The SC Speakers Bureau" is
// the body that produces it. They are deliberately not the same string, so the
// footer reads as a publication and its editor rather than as one organisation
// written two ways.
//
// There is no curator credit here. The client is the curator AND the webmaster
// and does not want the title in the masthead, so the credit lives once, in the
// footer, where it does not compete with the name for first attention on a site
// with one author.
//
// There is no `data-provisional` marker on the tagline either, because the
// tagline is cut from the Bureau's own sentence (see src/lib/site.ts) rather than
// standing in for copy the client has not supplied. A provisional marker that
// outlives the thing it marks is itself debris.
//
// ---------------------------------------------------------------------------
// WHY THE NAV IS LINKS AND NOT A SCRIPT
// ---------------------------------------------------------------------------
//
// The brief requires the site to be usable with JavaScript disabled, and this
// project has already learned that a control which silently degrades is worse
// than one that says what it does (see ThemeSwitcher.astro). Plain anchor
// elements are the whole navigation: they work with no scripting, they are
// crawlable, they
// can be opened in a new tab, copied, and middle-clicked. A menu built on
// button + script would need a working non-script fallback anyway, so the
// fallback would become the primary implementation and the script would only be
// removing a page load.
//

import { SITE_NAME, SITE_TAGLINE, withBase } from '../lib/site'

interface Props {
  /** The current path, used to mark the current nav item. */
  currentPath?: string
}

const { currentPath = '/' } = Astro.props

// Hardcoded here because these are SITE SECTIONS, not data. They are internal
// routes that exist whether or not the dataset has anything to put in them.
const navItems = [
  { href: '/', label: 'Latest' },
  { href: '/events/', label: 'Events' },
  { href: '/about/', label: 'About' }
]

const isCurrent = (href: string) => currentPath === href
---

<header class="masthead" style={`--masthead-banner: url('${withBase('/img/banner.jpg')}')`}>
  <div class="masthead__inner">
    <p class="masthead__name">
      <a class="masthead__home" href={withBase('/')}>
        {SITE_NAME}
      </a>
    </p>

    <p class="masthead__tagline">{SITE_TAGLINE}</p>

    <nav class="masthead__nav" aria-label="Primary">
      <ul class="masthead__list">
        {
          navItems.map((item) => (
            <li class="masthead__item">
              <a
                class="masthead__link"
                href={withBase(item.href)}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .masthead {
    position: relative;
    padding-block: var(--space-9) var(--space-8);
    border-block-end: var(--rule-width-strong) solid var(--rule-strong);
    /* The banner is a custom property set on the element itself by the
     * frontmatter, so the path goes through withBase() like every other asset
     * on this site. A literal url() here would hardcode the deployment root,
     * which is the one thing withBase() exists to prevent. */
    background-image: var(--masthead-banner);
    background-size: cover;
    background-position: center 30%;
    isolation: isolate;
  }

  .masthead::before {
    content: '';
    position: absolute;
    inset: 0;
    /* The mute is the theme's own page colour, not a black or white scrim, so
     * it darkens the painting on slate and lightens it on civic and ledger
     * instead of washing the dark themes out. */
    background: var(--bg);
    opacity: 0.62;
    z-index: -1;
  }

  .masthead__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  /* The whole masthead block is centred rather than ranged left. Three rules do
   * the work, and all three are needed:
   *
   *   1. `align-items: center` centres the flex children - the byline, the name,
   *      the tagline and the nav - because a column flex container otherwise
   *      stretches them to full width and leaves their text flush left.
   *   2. `text-align: center` centres the text INSIDE each of those children,
   *      which `align-items` alone does not do. Without it the name would sit
   *      centred as a box with its own text still flush left.
   *   3. The two children that set their own max-width - the tagline and the nav -
   *      need `margin-inline: auto` so the narrowed box itself is centred rather
   *      than left in a full-width slot.
   *
   * Why the nav is centred too rather than kept flush left: a centred masthead
   * with a left-hanging nav reads as two alignments fighting. The nav is the
   * horizontal element of the group, so centring the group centres it.
   *
   * Long single-word titles wrap by overflowing, so `overflow-wrap: anywhere` is
   * on the name. With a centred block an overflowing word pushes the whole line
   * off-centre, which is far more visible here than in a left-aligned one. */
  .masthead__inner {
    align-items: center;
    text-align: center;
  }

  .masthead__label {
    margin-block-end: var(--space-2);
  }

  .masthead__name {
    margin-block: 0;
    font-family: var(--font-display);
    font-size: var(--size-2xl);
    font-weight: var(--weight-bold);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    overflow-wrap: anywhere;
  }

  /* The site name is a link home on every page except the home page itself,
     where linking the H1 to the page you are on is a dead control. */
  .masthead__home {
    color: var(--text);
    text-decoration: none;
  }

  .masthead__home:hover,
  .masthead__home:focus-visible {
    color: var(--link-hover);
    text-decoration: underline;
  }

  .masthead__tagline {
    max-width: var(--measure);
    margin-block-end: 0;
    margin-inline: auto;
    font-size: var(--size-md);
    color: var(--text-muted);
  }

  .masthead__nav {
    margin-block-start: var(--space-4);
    margin-inline: auto;
  }

  .masthead__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2) var(--space-5);
    margin-block-end: 0;
    padding-inline-start: 0;
    list-style: none;
  }

  .masthead__link {
    font-size: var(--size-sm);
    letter-spacing: var(--tracking-normal);
  }

  /* The current page is marked by an underline AND by aria-current. Colour and
     bold weight alone would be the only signal otherwise, and bold weight is a
     weak signal for a reader who cannot distinguish the accent from the text
     colour. */
  .masthead__link[aria-current='page'] {
    font-weight: var(--weight-bold);
    text-decoration-thickness: var(--rule-width-strong);
  }
</style>
